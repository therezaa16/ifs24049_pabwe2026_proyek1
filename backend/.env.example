# Salin menjadi .env lalu sesuaikan.
NODE_ENV=development
PORT=5000
# WAJIB diisi pada production (gunakan string acak panjang).
JWT_SECRET=ganti-dengan-rahasia-yang-panjang-dan-acak
JWT_EXPIRES_IN=7d
DB_PATH=disiplin_finansial.sqlite
BCRYPT_SALT_ROUNDS=10
# Daftar origin yang diizinkan, pisahkan dengan koma. Kosongkan untuk mengizinkan semua.
CORS_ORIGIN=http://localhost:5173
# Offset zona waktu pengguna dalam menit (WIB = 420) untuk pengelompokan harian di dashboard.
TIMEZONE_OFFSET_MINUTES=420
# Pengali waktu misi belajar. 1 = waktu nyata. Untuk demo/video gunakan 0.04
# (Pomodoro 25 menit menjadi 60 detik). Server dan timer di frontend mengikuti nilai ini.
MISSION_TIME_SCALE=1
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
# Opsional: Google Gemini API Key untuk kuis Active Recall AI (bisa dikosongkan untuk memakai AI Semantic Engine bawaan)
GEMINI_API_KEY=
